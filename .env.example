# ==============================================================================
# CORE RESEARCH API KEYS (The 3 APIs that power 100% of the platform)
# ==============================================================================

# 1. GEMINI_API_KEY: Powers real-time Gemini AI Urban Climate Advisory and municipal Heat Action Plans.
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 2. COPERNICUS_CDS_API_KEY: Modernized Copernicus Climate Data Store (CDS) Personal Access Token (PAT).
# NOTE: The modern Copernicus CDS has shifted from legacy 2-part keys (UID:KEY) to a SINGLE Personal Access Token!
# No UID is needed. Register and copy your single token from: https://cds.climate.copernicus.eu/
COPERNICUS_CDS_API_KEY=""

# 3. NASA_EARTHDATA_TOKEN: NASA Earthdata Personal Access Token for Landsat 8/9 Thermal Infrared Band 10 LST.
# Register and generate your personal token at: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_TOKEN=""

# 4. OPENWEATHER_API_KEY: OpenWeatherMap API Key for live ground meteorological stations & barometric pressure.
# Register and copy your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

